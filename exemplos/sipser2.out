;I ; Traduzido do modelo de Sipser para fita duplamente infinita
; Fase 1: Preparar a fita marcando o início com '#' e deslocando a entrada para a direita
0 0 # R desloca_0
0 1 # R desloca_1
0 * # R desloca_outro
0 _ # R volta_inicio ; Entrada vazia

desloca_0 0 0 R desloca_0
desloca_0 1 0 R desloca_1
desloca_0 * 0 R desloca_outro
desloca_0 _ 0 L volta_inicio

desloca_1 0 1 R desloca_0
desloca_1 1 1 R desloca_1
desloca_1 * 1 R desloca_outro
desloca_1 _ 1 L volta_inicio

desloca_outro 0 * R desloca_0
desloca_outro 1 * R desloca_1
desloca_outro * * R desloca_outro
desloca_outro _ * L volta_inicio

volta_inicio * * L volta_inicio
volta_inicio # # R sim_0 ; Pronto para iniciar simulação no estado 0

; Fase 2: Regras originais traduzidas
sim_0 0 _ R sim_vai_fim
sim_0 1 _ * halt-reject
sim_0 _ _ * halt-reject ; Regra original de blank (lado direito)
sim_0 # # * halt-reject ; Tradução da regra de blank (parede esquerda)
sim_vai_fim 0 0 R sim_vai_fim
sim_vai_fim 1 1 R sim_vai_fim
sim_vai_fim _ _ L sim_check_fim ; Regra original de blank (lado direito)
sim_vai_fim # # L sim_check_fim ; Tradução da regra de blank (parede esquerda)
sim_check_fim 0 _ L sim_volta_inicio
sim_check_fim 1 _ * halt-reject
sim_check_fim _ _ * halt-accept ; Regra original de blank (lado direito)
sim_check_fim # # * halt-accept ; Tradução da regra de blank (parede esquerda)
sim_volta_inicio * * L sim_volta_inicio
sim_volta_inicio _ _ R sim_0 ; Regra original de blank (lado direito)
sim_volta_inicio # # R sim_0 ; Tradução da regra de blank (parede esquerda)

; Fase 3: Simulação da parede esquerda (símbolo '#') para estados sem regra de blank